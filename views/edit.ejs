<%- include('header') %>

<div class="ui grid">
  <div class="four wide column">
    <a class="avatar"
       href="/posts?author=<%= user._id %>"
       data-title="<%= user.name %>"
       data-content="<%= user.bio %>">
      <img class="avatar" src="/img/<%= user.avatar %>">
    </a>
  </div>

  <div class="eight wide column">
    <form class="ui form segment" method="post" action="/post/<%= post._id %>/edit">
      <div class="field required">
        <label>Title</label>
        <input type="text" name="title" value="<%= post.title %>">
      </div>
      <div class="field required">
        <label>Amount Spend</label>
        <input type="number" name="amount" value="<%= post.expense %>" step = "0.01">
      </div>
      <div class="field required">
        <label>Description</label>
        <textarea name="content" rows="15"><%= post.content %></textarea>
      </div>
      <input type="submit" class="ui button" value="Edit">
    </form>
  </div>
</div>

<%- include('footer') %>